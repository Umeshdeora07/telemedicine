# Copy to .env.local for local development, or set these in your host's
# secret manager for production. Everything is optional for a local demo:
# with no settings the app runs on an embedded database with demo data,
# shows OTP codes on screen and uses a test payment page.

# ---------------------------------------------------------------- Mode
# Demo mode shows demo logins and OTP codes and uses the test payment page.
# Defaults to on in development and off in production. NEVER enable it
# for real patients. It is always off on the Vercel production site,
# whatever this says (preview deployments may use it).
DEMO_MODE=
# Who becomes the admin. Empty: the first person to log in to a site that
# has no admin yet becomes the admin (once), so create your account yourself
# right after the first deploy. Set email addresses (comma separated) to
# allow only those: they become admins when they log in with an email code
# or Google (a password login doesn't prove the address, so it never counts).
ADMIN_EMAILS=
# Log in with an email or mobile number and a password. It needs no outside
# service, so it is on unless this is false. Forgotten passwords: Admin ->
# Users -> "Password reset link".
PASSWORD_LOGIN=
# Two step verification (an authenticator app) for doctors, coordinators and
# admins after they log in. Off unless this is true.
TWO_STEP=
# Password for the whole site (the browser asks once; any username). Use it
# for a public demo link so strangers can't get in. Empty: no password.
DEMO_ACCESS_PASSWORD=
# Public URL of the site, used in links, emails, OAuth callbacks and QR codes.
# On Render or Railway it defaults to the address they give the service.
APP_URL=http://localhost:3000
# Extra hosts allowed to submit forms (Server Actions) when a proxy forwards
# its own host, e.g. a tunnel. Comma-separated host[:port]. Inside a GitHub
# Codespace the forwarded address is added automatically.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------- Brand
# The brand name and contact details appear across the site, emails, PDFs
# and legal pages. Replace the placeholders before launch.
NEXT_PUBLIC_BRAND_NAME=CareMitra
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_REGISTERED_ADDRESS=
NEXT_PUBLIC_GSTIN=
# Grievance Officer (required under the IT Rules 2021 and DPDP Act 2023).
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_EMAIL=
NEXT_PUBLIC_GRIEVANCE_PHONE=

# ---------------------------------------------------------------- Languages
# The site is in English only for now. The Hindi translation is kept: set
# ENABLED_LOCALES=en,hi to show the language switch again. The theme is light
# by default and visitors can switch to dark; there are no other display
# settings.
ENABLED_LOCALES=en

# ---------------------------------------------------------------- Database
# Leave DATABASE_URL empty to use the embedded database (PGlite) in .data/.
# POSTGRES_URL and prefixed names from Vercel's storage integrations
# (e.g. STORAGE_DATABASE_URL) are also recognised.
# Only one process can open the embedded database at a time.
# For production, use PostgreSQL 15+ (managed, encrypted, in an Indian region).
DATABASE_URL=
DATABASE_POOL_SIZE=10
# Apply migrations on boot (PostgreSQL). Set to false if you run
# `npm run db:migrate` in your deploy pipeline instead.
DB_AUTO_MIGRATE=true
# Demo mode loads demo data into an empty database on boot (and reloads it
# each new day). Set to false to keep a demo database empty.
DEMO_AUTO_SEED=
PGLITE_DIR=
# `npm run db:reset` refuses to wipe a PostgreSQL database unless this is true.
ALLOW_DB_RESET=false

# ---------------------------------------------------------------- Files
# Uploaded reports, doctors' documents and generated PDFs, encrypted with
# AES-256-GCM. Defaults to .data/uploads. On Vercel files are stored in the
# database instead (its disk is temporary). STORAGE_DRIVER=database or disk
# overrides the choice.
STORAGE_DIR=
STORAGE_DRIVER=

# ---------------------------------------------------------------- Secrets
# Required whenever DATABASE_URL is set, and in production. Either one
# APP_SECRET (32+ random characters, e.g. `openssl rand -base64 32`) that
# every key is derived from, or the four keys from `npm run keys`. Only a
# local demo on the embedded database generates its own into .data/.
# Keep them in a password manager: losing them makes stored files
# unreadable, and changing APP_SECRET changes every key.
APP_SECRET=
DATA_ENCRYPTION_KEY=
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=
HASH_SECRET=

# ---------------------------------------------------------------- Scheduler
# Consult reminders, doctor no-show refunds, slot generation, registration expiry checks
# and notification delivery run every minute inside the Node.js server.
# On serverless hosting, set DISABLE_INTERNAL_SCHEDULER=1 and call
#   POST /api/cron/tick   with header   Authorization: Bearer $CRON_SECRET
# once a minute from your host's cron.
DISABLE_INTERNAL_SCHEDULER=
CRON_SECRET=

# ---------------------------------------------------------------- Business rules
# Platform fee in paise (GST is added on top). Default ₹25.
PLATFORM_FEE_INR_PAISE=2500
GST_RATE=0.18
# State of the platform's GST registration (decides CGST+SGST vs IGST).
PLATFORM_GST_STATE=Karnataka
# Share of the consultation fee kept by the platform.
DOCTOR_COMMISSION_RATE=0.15
# Minutes after the start time before an absent doctor triggers a full refund.
DOCTOR_NO_SHOW_MINUTES=10
# Idle logout. Staff: 15 minutes. Patients: 14 days.
SESSION_IDLE_MINUTES_STAFF=15
SESSION_IDLE_MINUTES_PATIENT=20160

# ---------------------------------------------------------------- Payments
# With neither gateway set, a test payment page is used (demo mode only).
# Razorpay (India: UPI, cards, net banking, wallets).
# Webhook URL: $APP_URL/api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Stripe Checkout (international cards and wallets).
# Webhook URL: $APP_URL/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Sign-in
# Optional social sign-in. Callback: $APP_URL/api/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM contents; use \n for line breaks on one line.
APPLE_PRIVATE_KEY=

# ---------------------------------------------------------------- Messages
# Without these, messages are logged to the server console (and OTP codes
# are shown on screen in demo mode).
# Login by mobile number: Twilio Verify sends and checks the codes (paid per
# code). Create a Verify service in the Twilio console and copy its SID (VA...).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Other SMS (reminders) through Twilio messages. For India, register DLT
# templates with your telecom operator.
TWILIO_FROM=
# WhatsApp Business Cloud API.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Email (Resend; needs your own domain verified in Resend).
RESEND_API_KEY=
EMAIL_FROM=
# Or email from any mail account by SMTP, for example your Gmail address and a
# Google app password (myaccount.google.com/apppasswords). Gmail is the
# default host. EMAIL_FROM is optional here.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
# Web Push. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------- Video
# Public STUN servers are used by default. Add a TURN server (for example
# coturn) so calls connect on strict mobile and office networks.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
